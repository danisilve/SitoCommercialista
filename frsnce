<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Studio Franceschini | Commercialista a Brescia</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- GSAP & ScrollTrigger -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Montserrat:wght@200;300;400;500&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #0a0a0b;
            --gold: #c5a059;
            --gold-light: #e2c286;
            --bg-creme: #faf9f6;
            --nav-height: 100px;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-creme);
            color: var(--primary);
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        h1, h2, h3, .font-serif {
            font-family: 'Cormorant Garamond', serif;
            letter-spacing: -0.02em;
        }

        /* Stile specifico per il titolo Hero richiesto */
        .hero-title {
            font-family: 'Cormorant Garamond', serif;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-weight: 300;
        }

        .gold-text {
            color: var(--gold);
        }

        /* Logo Styling */
        .logo-container {
            display: flex;
            align-items: center; 
            gap: 4px; 
            cursor: pointer;
        }

        .logo-icon {
            width: 38px;
            height: 38px;
            border: 1px solid var(--gold);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            position: relative;
            flex-shrink: 0;
        }

        .logo-icon::before {
            content: 'F';
            font-family: 'Cormorant Garamond', serif;
            font-size: 22px;
            font-style: italic;
            color: var(--gold);
            margin-top: -1px; 
            margin-left: 1px;
        }

        .logo-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: 24px;
            font-weight: 300;
            text-transform: uppercase;
            letter-spacing: 0.35em;
            color: var(--gold);
            line-height: 1;
            padding-top: 2px; 
        }

        /* Navigazione */
        nav {
            height: var(--nav-height);
            background-color: #000000;
            border-bottom: 1px solid rgba(197, 160, 89, 0.3);
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .nav-hidden {
            transform: translateY(-100%);
        }

        .hero-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-image: url('https://images.unsplash.com/photo-1554224155-6726b3ff858f?q=80&w=2000&auto=format&fit=crop'); 
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            padding-top: var(--nav-height);
        }

        .hero-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.9) 100%);
            z-index: 1;
        }

        /* Pulsante Hero */
        .btn-hero {
            border: 1px solid #ffffff;
            background-color: transparent;
            color: #ffffff;
            padding: 1.25rem 3rem;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            transition: all 0.4s ease;
            display: inline-block;
        }

        .btn-hero:hover {
            background-color: #ffffff;
            color: #000000;
        }

        .luxury-border {
            border: 1px solid rgba(197, 160, 89, 0.2);
        }

        .deco-line {
            width: 1px;
            height: 100px;
            background: linear-gradient(to bottom, transparent, var(--gold), transparent);
        }

        .nav-item {
            position: relative;
            letter-spacing: 0.15em;
            font-size: 0.75rem;
        }

        .nav-item::after {
            content: '';
            position: absolute;
            width: 0;
            height: 1px;
            bottom: -5px;
            left: 0;
            background-color: var(--gold);
            transition: width 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .nav-item:hover::after {
            width: 100%;
        }

        .reveal {
            opacity: 0;
            transform: translateY(40px);
            z-index: 2;
        }

        .custom-cursor {
            width: 25px;
            height: 25px;
            border: 1px solid var(--gold);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 10000;
            mix-blend-mode: difference;
        }

        input, textarea {
            background: transparent !important;
            border-bottom: 1px solid rgba(197, 160, 89, 0.3) !important;
            transition: border-color 0.4s ease;
            text-align: center;
        }

        input:focus, textarea:focus {
            outline: none;
            border-bottom: 1px solid var(--gold) !important;
        }

        input::placeholder, textarea::placeholder {
            text-align: center;
        }
    </style>
</head>
<body>

    <div id="cursor" class="custom-cursor hidden md:block"></div>

    <!-- Header -->
    <nav id="main-nav" class="fixed top-0 w-full z-50 flex items-center">
        <div class="max-w-7xl mx-auto px-10 w-full flex justify-between items-center">
            <div class="logo-container" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
                <div class="logo-icon"></div>
                <div class="logo-text">ranceschini</div>
            </div>
            
            <div class="hidden md:flex space-x-12 items-center font-medium uppercase text-xs tracking-widest gold-text">
                <a href="#expertise" class="nav-item">Expertise</a>
                <a href="#filosofia" class="nav-item">Filosofia</a>
                <a href="#contatti" class="px-8 py-3 border border-gold/50 hover:bg-gold hover:text-black transition-all duration-500">Privé</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section text-white relative overflow-hidden">
        <div class="max-w-6xl mx-auto px-6 text-center relative z-10 w-full">
            <div class="reveal">
                <h5 class="text-gold tracking-[0.4em] uppercase text-[10px] mb-6 font-semibold">Consulenza D'Elite</h5>
                <!-- Titolo Aggiornato: Stesso font del logo, no corsivo, centrato -->
                <h1 class="hero-title text-4xl md:text-6xl lg:text-7xl mb-10 leading-tight text-center">
                    Commercialista <br><span>a Brescia</span>
                </h1>
                <p class="text-slate-200 font-light text-base md:text-lg mb-12 mx-auto max-w-xl leading-relaxed text-center">
                    Strategie fiscali e gestione della ricchezza con la precisione di un mastro orologiaio e la visione di un architetto.
                </p>
                <div class="flex flex-col md:flex-row items-center justify-center space-y-6 md:space-y-0 md:space-x-8">
                    <a href="#expertise" class="btn-hero shadow-xl">Scopri i Servizi</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Expertise Section -->
    <section id="expertise" class="py-32 bg-creme relative">
        <div class="max-w-7xl mx-auto px-10">
            <div class="flex flex-col items-center mb-24 text-center">
                <div class="deco-line mb-8"></div>
                <h2 class="text-5xl font-serif mb-4">Expertise di Valore</h2>
                <p class="text-slate-500 uppercase tracking-[0.3em] text-[10px]">Competenza tecnica di alto livello</p>
            </div>

            <div class="grid md:grid-cols-3 gap-1px bg-gold/20 luxury-border overflow-hidden shadow-2xl">
                <div class="bg-creme p-16 hover:bg-white transition-colors duration-500 group text-center flex flex-col items-center">
                    <span class="text-gold text-xs tracking-widest block mb-10">I.</span>
                    <h3 class="text-3xl font-serif mb-6 transition-all">Consulenza <br>Tributaria</h3>
                    <p class="text-slate-500 font-light leading-relaxed mb-8">Gestione complessa e pianificazione fiscale per garantire stabilità nel tempo.</p>
                    <div class="w-12 h-px bg-gold/40 group-hover:w-24 transition-all duration-700"></div>
                </div>

                <div class="bg-creme p-16 hover:bg-white transition-colors duration-500 group text-center flex flex-col items-center">
                    <span class="text-gold text-xs tracking-widest block mb-10">II.</span>
                    <h3 class="text-3xl font-serif mb-6 transition-all">Wealth <br>Management</h3>
                    <p class="text-slate-500 font-light leading-relaxed mb-8">Protezione dei grandi patrimoni e consulenza per passaggi generazionali.</p>
                    <div class="w-12 h-px bg-gold/40 group-hover:w-24 transition-all duration-700"></div>
                </div>

                <div class="bg-creme p-16 hover:bg-white transition-colors duration-500 group text-center flex flex-col items-center">
                    <span class="text-gold text-xs tracking-widest block mb-10">III.</span>
                    <h3 class="text-3xl font-serif mb-6 transition-all">Corporate <br>Strategy</h3>
                    <p class="text-slate-500 font-light leading-relaxed mb-8">Operazioni straordinarie e strutturazione societaria per lo sviluppo del business.</p>
                    <div class="w-12 h-px bg-gold/40 group-hover:w-24 transition-all duration-700"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Filosofia Section -->
    <section id="filosofia" class="py-32 bg-black text-white relative overflow-hidden">
        <div class="max-w-5xl mx-auto px-10 text-center relative z-10">
            <h2 class="text-gold font-serif italic text-4xl md:text-6xl mb-12">
                "La riservatezza è il nostro sigillo, la competenza la nostra firma."
            </h2>
            <div class="flex justify-center items-center space-x-4">
                <div class="h-px w-10 bg-gold/50"></div>
                <p class="uppercase tracking-[0.4em] text-[10px] font-medium">Dott. Franceschini</p>
                <div class="h-px w-10 bg-gold/50"></div>
            </div>
        </div>
    </section>

    <!-- Sezione Contatto -->
    <section id="contatti" class="py-32 bg-white relative">
        <div class="max-w-7xl mx-auto px-10 text-center">
            <div class="reveal mb-20">
                <h2 class="text-5xl font-serif mb-8 leading-tight italic">Contatto <span class="not-italic gold-text">Diretto</span></h2>
                <p class="text-slate-500 font-light text-lg mx-auto max-w-2xl leading-relaxed">
                    Per sottoporre la vostra posizione o richiedere una consulenza preliminare, vi invitiamo a compilare il modulo o a contattare direttamente i nostri uffici.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-12 mb-20 reveal">
                <div class="p-8 luxury-border flex flex-col items-center">
                    <div class="w-10 h-10 mb-4 flex items-center justify-center text-gold italic font-serif border border-gold/30 rounded-full">A</div>
                    <h4 class="text-[10px] uppercase tracking-widest text-slate-400 mb-2">Ufficio di Brescia</h4>
                    <p class="text-lg font-serif">Via delle Muse, 5 — 25121 Brescia (BS)</p>
                </div>
                <div class="p-8 luxury-border flex flex-col items-center">
                    <div class="w-10 h-10 mb-4 flex items-center justify-center text-gold italic font-serif border border-gold/30 rounded-full">T</div>
                    <h4 class="text-[10px] uppercase tracking-widest text-slate-400 mb-2">Linee Telefoniche</h4>
                    <p class="text-lg font-serif">+39 030 00 00 00</p>
                </div>
                <div class="p-8 luxury-border flex flex-col items-center">
                    <div class="w-10 h-10 mb-4 flex items-center justify-center text-gold italic font-serif border border-gold/30 rounded-full">E</div>
                    <h4 class="text-[10px] uppercase tracking-widest text-slate-400 mb-2">Corrispondenza</h4>
                    <p class="text-lg font-serif">info@studiofranceschini.it</p>
                </div>
            </div>

            <div class="max-w-3xl mx-auto reveal">
                <div class="bg-creme p-12 luxury-border shadow-sm">
                    <form action="#" class="space-y-10" onsubmit="event.preventDefault();">
                        <div class="grid md:grid-cols-2 gap-10">
                            <div>
                                <label class="text-[9px] uppercase tracking-[0.3em] text-slate-400 block mb-2">Nome</label>
                                <input type="text" placeholder="Nome" class="w-full py-2 text-sm font-light">
                            </div>
                            <div>
                                <label class="text-[9px] uppercase tracking-[0.3em] text-slate-400 block mb-2">Cognome</label>
                                <input type="text" placeholder="Cognome" class="w-full py-2 text-sm font-light">
                            </div>
                        </div>
                        <div>
                            <label class="text-[9px] uppercase tracking-[0.3em] text-slate-400 block mb-2">Email Professionale</label>
                            <input type="email" placeholder="email@esempio.it" class="w-full py-2 text-sm font-light">
                        </div>
                        <div>
                            <label class="text-[9px] uppercase tracking-[0.3em] text-slate-400 block mb-2">Messaggio</label>
                            <textarea rows="3" placeholder="Descriva brevemente la sua richiesta" class="w-full py-2 text-sm font-light resize-none"></textarea>
                        </div>
                        <button type="submit" class="w-full md:w-auto md:px-20 bg-black text-white py-5 text-[10px] uppercase tracking-[0.3em] font-bold hover:bg-gold transition-all duration-500 shadow-xl mx-auto block">Invia Richiesta</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <footer class="py-12 bg-black text-slate-600 text-[9px] tracking-[0.3em] uppercase text-center border-t border-gold/10">
        <div class="max-w-7xl mx-auto px-10 flex flex-col md:flex-row justify-between items-center">
            <p>&copy; 2024 Studio Franceschini — Commercialista a Brescia</p>
            <div class="space-x-8 mt-4 md:mt-0">
                <a href="#" class="hover:text-gold transition-colors">Privacy Policy</a>
                <a href="#" class="hover:text-gold transition-colors">Legal Notes</a>
            </div>
        </div>
    </footer>

    <script>
        gsap.registerPlugin(ScrollTrigger);

        window.addEventListener('load', () => {
            const cursor = document.getElementById('cursor');
            const nav = document.getElementById('main-nav');
            
            window.addEventListener('scroll', () => {
                const scrollY = window.scrollY;
                const heroHeight = document.querySelector('.hero-section').offsetHeight;

                if (scrollY > (heroHeight - 100)) {
                    nav.classList.add('nav-hidden');
                } else {
                    nav.classList.remove('nav-hidden');
                }
            });

            window.addEventListener('mousemove', (e) => {
                gsap.to(cursor, {
                    x: e.clientX - 12,
                    y: e.clientY - 12,
                    duration: 0.2,
                    ease: "power2.out"
                });
            });

            gsap.to(".reveal", {
                opacity: 1,
                y: 0,
                duration: 1.2,
                stagger: 0.2,
                scrollTrigger: {
                    trigger: ".reveal",
                    start: "top 85%",
                }
            });
        });
    </script>
</body>
</html>

